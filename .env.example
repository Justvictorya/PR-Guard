# Copy this file to .env and fill in your keys.
# NEVER commit .env to git.

# Get this free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get this at https://github.com/settings/tokens
# Required scopes: read:repo (for public repos, no scopes needed)
GITHUB_TOKEN=your_github_token_here

# Optional: switch LLM provider (groq | openai)
# Defaults to groq if not set.
LLM_PROVIDER=groq

# Optional: override the default model name
# Groq default: llama3-8b-8192
# OpenAI default: gpt-4o-mini
LLM_MODEL=llama3-8b-8192
